# Process health does not require a reachable database.
# Provision a restricted runtime role separately from the migration owner.
SPENDWISE_DATABASE_URL=postgresql+psycopg://spendwise_runtime:replace-me@localhost:5432/spendwise
SPENDWISE_DATABASE_POOL_SIZE=5
SPENDWISE_DATABASE_MAX_OVERFLOW=0
# Migration commands use this variable only; never supply it to the API host.
SPENDWISE_MIGRATION_DATABASE_URL=postgresql+psycopg://spendwise_owner:replace-me@localhost:5432/spendwise
# Used only by local Compose, not the API. Choose a disposable local password.
SPENDWISE_LOCAL_POSTGRES_PASSWORD=replace-me
